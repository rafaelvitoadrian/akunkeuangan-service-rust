# Copy to .env.opensource, set your own passwords, never commit that file.
POSTGRES_DB=akunkeuangan
POSTGRES_USER=akunkeuangan
POSTGRES_PASSWORD=
HOST_PORT=9091
APP_UTC_OFFSET_MINUTES=420
RUST_LOG=info
POSTGRES_BOOTSTRAP_USER=
POSTGRES_BOOTSTRAP_ADMIN_EMAIL=
CORS_ALLOWED_ORIGINS=
# Override for a fork or a new public registry project:
AKUN_IMAGE_REGISTRY=registry.gitlab.com/rafaelvito11/akunkeuangan-service-rust
# To create your own first user, set email|password above, then remove it.
# To grant that user admin rights once, set its email in BOOTSTRAP_ADMIN_EMAIL,
# then clear the variable after provisioning. No fixed demo user is shipped.
