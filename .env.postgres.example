# Copy to .env.postgres. This is independent from your existing Oracle .env.
REPO_BACKEND=postgres
DATABASE_URL=postgres://akunkeuangan@localhost:5432/akunkeuangan
# A separate password can contain URL-reserved characters without encoding.
DATABASE_PASSWORD='change_me'
POSTGRES_AUTO_MIGRATE=true
# Optional initial user: only created when this email does not exist.
# Set your own password; remove this value after the first successful login.
POSTGRES_BOOTSTRAP_USER=
# Existing imported user: explicitly grant UserAccount Approve once, then clear.
# POSTGRES_BOOTSTRAP_ADMIN_EMAIL=admin1
SERVER_PORT=9091
APP_UTC_OFFSET_MINUTES=420
RUST_LOG=info
APP_LOG_FILE=.runtime/logs/rust-postgres.log
# Optional cross-domain frontend origins, comma-separated, no trailing slash.
# CORS_ALLOWED_ORIGINS=https://frontend.example.com,http://localhost:5173

# Compose-only settings (used with --env-file .env.postgres).
POSTGRES_DB=akunkeuangan
POSTGRES_USER=akunkeuangan
# Keep in sync with DATABASE_PASSWORD when running the Rust binary on Windows.
POSTGRES_PASSWORD='change_me'
POSTGRES_HOST_PORT=5432
HOST_PORT=9091
# Uncomment to pull the PostgreSQL variant built by GitLab:
# AKUN_POSTGRES_IMAGE=registry.gitlab.com/group/project:postgres-latest
